PORT=8787
PALMER_LOU_REQUIRE_BLUETOOTH_READY=false
PALMER_LOU_NMEA2000_ENABLED=true
PALMER_LOU_SIGNALK_BASE_URL=http://127.0.0.1:3000
PALMER_LOU_SIGNALK_TIMEOUT_MS=1800
PALMER_LOU_NMEA_CACHE_MS=1500
PALMER_LOU_NMEA_STALE_MS=15000
PALMER_LOU_NMEA0183_ENABLED=true
PALMER_LOU_NMEA0183_DEVICE=auto
PALMER_LOU_NMEA0183_BAUD=38400
PALMER_LOU_NMEA0183_BAUDS=38400,115200,9600,4800
PALMER_LOU_NMEA0183_READ_SECONDS=3

# Optional launch command map (quote the entire JSON string so shell parsing does not split it)
PALMER_LOU_LAUNCH_COMMANDS='{"youtube":"chromium --app=https://www.youtube.com/tv --start-fullscreen","youtube-tv":"chromium --app=https://tv.youtube.com/ --start-fullscreen","spotify":"flatpak run com.spotify.Client"}'

# Allow browser-backed apps (Netflix, Paramount, etc.) to open in Chromium when no explicit command is set.
# Defaults to true; set to false to force in-shell bridge mode for unconfigured apps.
# PALMER_LOU_ALLOW_BROWSER_FALLBACK=true

# Absolute path to the unpacked kiosk extension directory loaded via --load-extension.
# Defaults to /home/palmerlou/palmer-lou-extension (set by install-linux.sh).
# PALMER_LOU_EXTENSION_DIR=/home/palmerlou/palmer-lou-extension

# Remote access / reverse tunnel controls (Starlink-friendly outbound connectivity)
PALMER_LOU_REMOTE_ACCESS_MODE=tailscale
PALMER_LOU_REMOTE_ACCESS_LABEL=Tailscale overlay
PALMER_LOU_REMOTE_VIEW_URL=https://login.tailscale.com/admin/machines
PALMER_LOU_REMOTE_TROUBLESHOOT_URL=https://login.tailscale.com/admin/machines
PALMER_LOU_REMOTE_TUNNEL_STATUS_COMMAND=tailscale status
PALMER_LOU_REMOTE_TUNNEL_START_COMMAND=systemctl start tailscaled
PALMER_LOU_REMOTE_TUNNEL_STOP_COMMAND=systemctl stop tailscaled
PALMER_LOU_REMOTE_TUNNEL_RESTART_COMMAND=systemctl restart tailscaled

# Optional explicit update command run by Settings -> Apply remote update
# If unset on Linux, backend defaults to infrastructure/scripts/update.sh
# PALMER_LOU_REMOTE_UPDATE_COMMAND=PALMER_LOU_REPO_DIR=/opt/palmer-lou bash /opt/palmer-lou/infrastructure/scripts/update.sh

