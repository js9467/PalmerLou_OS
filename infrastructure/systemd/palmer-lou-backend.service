[Unit]
Description=Palmer Lou Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/palmer-lou
EnvironmentFile=-/etc/palmer-lou/backend.env
Environment=PORT=8787
ExecStart=/usr/bin/npm run start -w apps/backend
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
