{
  "manifest_version": 3,
  "name": "Palmer Lou Home Button",
  "version": "1.0",
  "description": "Injects a floating Home button on every page for touchscreen kiosk navigation.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "host_permissions": ["<all_urls>"]
}
